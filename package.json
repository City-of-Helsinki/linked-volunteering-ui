  "scripts": {
    "app:version": "echo \"$npm_package_version\"",
    "start": "pnpm update-runtime-env && vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "NODE_ENV=test pnpm update-runtime-env && vitest",
    "test:coverage": "NODE_ENV=test pnpm update-runtime-env && vitest run --coverage --watch=false",
    "lint": "eslint src && prettier src --check",
    "lint:fix": "eslint src --fix && prettier src --write",
    "typecheck": "tsc --noEmit",
    "test:e2e:install": "npx playwright install",
    "test:e2e:ci": "npx playwright test",
    "test:e2e:start": "npx playwright test",
    "test:e2e:record": "npx playwright codegen https://puistotalkoot.dev.hel.ninja/",
    "update-runtime-env": "tsx --tsconfig ./scripts/tsconfig.json scripts/update-runtime-env.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
